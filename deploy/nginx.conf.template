# === Phase 1: HTTP only (초기 세팅, certbot 인증서 발급 전) ===

server {
    listen 80;
    server_name ${DOMAIN};

    # Let's Encrypt 인증 챌린지
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # HTTPS 미설정 시 HTTP로 서비스 (초기 세팅용)
    # HTTPS 설정 완료 후 아래 블록을 주석 처리하고 301 리다이렉트로 교체
    # return 301 https://$server_name$request_uri;

    # ===== Admin BFF =====
    location /api/v1/admin/ {
        proxy_pass http://admin-bff:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # CORS
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Authorization, Content-Type, X-DEVICE-TOKEN" always;

        if ($request_method = OPTIONS) {
            return 204;
        }
    }

    # ===== Kiosk BFF (REST) =====
    location /api/v1/kiosk/ {
        proxy_pass http://kiosk-bff:8082;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # CORS
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Authorization, Content-Type, X-DEVICE-TOKEN" always;

        if ($request_method = OPTIONS) {
            return 204;
        }
    }

    # ===== Kiosk BFF (WebSocket STT/TTS) =====
    location /ws/ {
        proxy_pass http://kiosk-bff:8082;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # ===== Health Check =====
    location /health {
        proxy_pass http://admin-bff:8081;
    }

    # ===== Swagger (개발 중에만) =====
    location /swagger-ui/ {
        proxy_pass http://admin-bff:8081;
    }
    location /v3/api-docs/ {
        proxy_pass http://admin-bff:8081;
    }
}

