# === HTTPS 설정 완료 버전 ===

# HTTP -> HTTPS 리다이렉트
server {
    listen 80;
    server_name ${DOMAIN};

    # Let's Encrypt 인증 챌린지 (인증서 갱신용)
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # 나머지 모든 요청은 HTTPS로 리다이렉트
    location / {
        return 301 https://$server_name$request_uri;
    }
}

# HTTPS 서버
server {
    listen 443 ssl;
    server_name ${DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # 파일 업로드 최대 크기 (Spring의 50MB와 동일하게 설정)
    client_max_body_size 50M;

    # ===== Admin BFF =====
    location /api/v1/admin/ {
        proxy_pass http://admin-bff:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # CORS는 Spring Security에서 처리 (중복 방지)
    }

    # ===== Kiosk BFF (REST) =====
    location /api/v1/kiosk/ {
        proxy_pass http://kiosk-bff:8082;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # CORS는 Spring Security에서 처리 (중복 방지)
    }

    # ===== Kiosk BFF (WebSocket STT/TTS) =====
    location /ws/ {
        proxy_pass http://kiosk-bff:8082;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # ===== Health Check =====
    location /health {
        proxy_pass http://admin-bff:8081;
    }

    # ===== Swagger (개발 중에만) =====
    location /swagger-ui/ {
        proxy_pass http://admin-bff:8081;
    }
    location /v3/api-docs/ {
        proxy_pass http://admin-bff:8081;
    }
}
